PORT=8000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/habit-tracker

# Use a long random string, e.g. the output of:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# Google Gemini API key (https://aistudio.google.com/apikey)
# Leave empty to run without AI features
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173
